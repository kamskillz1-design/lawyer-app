{
  "name": "ChecklistItem",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string"
    },
    "matter_number": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "portal_user_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "title_client": {
      "type": "string"
    },
    "why_required": {
      "type": "string"
    },
    "client_note": {
      "type": "string"
    },
    "who_provides": {
      "type": "string",
      "enum": [
        "client",
        "office",
        "authority",
        "third_party"
      ],
      "default": "client"
    },
    "original_required": {
      "type": "boolean",
      "default": false
    },
    "translation_required": {
      "type": "boolean",
      "default": false
    },
    "apostille_required": {
      "type": "boolean",
      "default": false
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "needed",
        "uploaded",
        "being_checked",
        "accepted",
        "needs_correction",
        "not_required"
      ],
      "default": "needed"
    },
    "staff_notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "matter_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.portal_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}