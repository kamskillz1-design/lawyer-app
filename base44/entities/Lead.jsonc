{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "country_of_residence": {
      "type": "string"
    },
    "enquiry_category": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "whatsapp",
        "office"
      ]
    },
    "referral_source": {
      "type": "string"
    },
    "appointment_preference": {
      "type": "string"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "pending",
        "granted",
        "refused"
      ],
      "default": "pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "awaiting_response",
        "appointment_proposed",
        "appointment_booked",
        "consultation_completed",
        "awaiting_engagement",
        "converted",
        "not_proceeding",
        "referred_elsewhere",
        "closed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "converted_client_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "web"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}