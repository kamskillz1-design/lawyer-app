{
  "name": "Communication",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "matter_number": {
      "type": "string"
    },
    "portal_user_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "internal"
      ],
      "default": "inbound"
    },
    "channel": {
      "type": "string",
      "enum": [
        "portal",
        "email",
        "phone",
        "office",
        "video",
        "letter",
        "whatsapp"
      ],
      "default": "portal"
    },
    "sender": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "original_language": {
      "type": "string"
    },
    "original_content": {
      "type": "string"
    },
    "staff_translation": {
      "type": "string"
    },
    "translation_method": {
      "type": "string",
      "enum": [
        "ai",
        "approved_template",
        "staff",
        "human"
      ]
    },
    "translation_confidence": {
      "type": "string",
      "enum": [
        "normal",
        "review_recommended",
        "uncertain",
        "human_required"
      ]
    },
    "reply_original": {
      "type": "string"
    },
    "reply_translation": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "routine",
        "important",
        "lawyer_review",
        "urgent"
      ],
      "default": "routine"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "draft",
        "translation_pending",
        "pending_review",
        "lawyer_pending",
        "sent",
        "internal_note"
      ],
      "default": "received"
    },
    "owner": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "action_required": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "original_content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.portal_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.portal_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}